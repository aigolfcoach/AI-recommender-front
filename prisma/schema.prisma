generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  password     String
  profileImage String?  // 프로필 이미지 URL (선택적)
  role         String   @default("user") // 'user' 또는 'admin'
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // 토큰 사용량 기록과의 관계
  tokenUsages TokenUsage[]
  // 대화 기록과의 관계
  conversations Conversation[]

  @@map("users")
}

model TokenUsage {
  id        String   @id @default(cuid())
  provider  String   // 'openai', 'grok', 'gemini' 등
  model     String   // 모델명
  tokens    Int      // 사용된 토큰 수
  userId    String?  // 사용자 ID (선택적)
  createdAt DateTime @default(now())

  // 사용자와의 관계
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("token_usages")
}

model Conversation {
  id        String   @id @default(cuid())
  userId    String?
  question  String
  systemPrompt String?
  temperature Float
  maxTokens Int
  responses Json     // AI 응답들을 JSON으로 저장
  summary   String?  // AI 응답 요약
  reliabilityScore Float?  // 신뢰도 점수
  reliabilityGrade String? // 신뢰도 등급
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  user User? @relation(fields: [userId], references: [id])

  @@map("conversations")
}
